# 📖 https://docs.reliverse.org/relivator/env

# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
# ―― APP ―――――――――――――――――――――――――――――――――――
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# use https://example.com in production
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_SERVER_APP_URL="http://localhost:3000"

# fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
# ―― DATABASE ――――――――――――――――――――――――――――――
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# https://console.neon.tech/app/projects
DATABASE_URL="postgresql://..."

# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
# ―― AUTHENTICATION ――――――――――――――――――――――――
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# bunx randomstring length=32
AUTH_SECRET="..."

# https://console.cloud.google.com/apis/credentials
# Create credentials > OAuth client ID
# Authorized JavaScript origins: https://example.com && http://localhost:3000
# Authorized redirect URIs: https://example.com/api/auth/callback/google && http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="..."
AUTH_GOOGLE_SECRET="..."

# https://github.com/settings/developers
# https://example.com/api/auth/callback/github
AUTH_GITHUB_ID="..."
AUTH_GITHUB_SECRET="..."

# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
# ―― UPLOADS ―――――――――――――――――――――――――――――――
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# https://uploadthing.com/dashboard
UPLOADTHING_TOKEN="..."
UPLOADTHING_SECRET_KEY="sk_live_..."

# Product images: "uploadthing" (default; needs UPLOADTHING_TOKEN) or
# "local" (files under IMAGE_STORAGE_LOCAL_DIR, served by /api/v1/images).
# Local storage is refused in production unless the flag is exactly "true"
# and the directory is on a persistent volume.
IMAGE_STORAGE_DRIVER="local"
IMAGE_STORAGE_LOCAL_DIR=".data/images"
IMAGE_STORAGE_ALLOW_LOCAL_IN_PRODUCTION=

# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
