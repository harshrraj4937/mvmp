# Copy to .env. Generate each secret with: openssl rand -hex 32
# Use a hex password so it can be embedded in DATABASE_URL without URL encoding.
POSTGRES_PASSWORD=
AUTH_SECRET=

APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_SERVER_APP_URL=http://localhost:3000

# Optional integrations: supply real credentials to use these features.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
UPLOADTHING_TOKEN=
UPLOADTHING_SECRET_KEY=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ENVIRONMENT=sandbox
