# Copy to .env (or point GILLU_ENV_FILE at another file).
# Generate each secret with: openssl rand -hex 32
# Use a hex password so it can be embedded in DATABASE_URL without URL encoding.
POSTGRES_PASSWORD=
AUTH_SECRET=

# nginx is the only published service. Keep the app URLs in sync with it;
# NEXT_PUBLIC_APP_URL is embedded at build time, so rebuild when it changes.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
NEXT_PUBLIC_APP_URL=http://localhost:8080
NEXT_SERVER_APP_URL=http://localhost:8080

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Optional integrations: supply real credentials to use these features.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
UPLOADTHING_TOKEN=
UPLOADTHING_SECRET_KEY=
# Product images: uploadthing (needs UPLOADTHING_TOKEN) or local. Local in
# production also needs IMAGE_STORAGE_ALLOW_LOCAL_IN_PRODUCTION=true and a
# persistent volume mounted at IMAGE_STORAGE_LOCAL_DIR.
IMAGE_STORAGE_DRIVER=uploadthing
IMAGE_STORAGE_LOCAL_DIR=
IMAGE_STORAGE_ALLOW_LOCAL_IN_PRODUCTION=
